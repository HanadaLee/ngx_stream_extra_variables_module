ngx_addon_name=ngx_stream_extra_variables_module

if [ "$ngx_module_link" = DYNAMIC ]; then
    echo "$0: error: ngx_stream_extra_variables_module must be built with --add-module"
    exit 1
fi

if [ "$STREAM" = DYNAMIC ]; then
    echo "$0: error: ngx_stream_extra_variables_module requires a static Stream subsystem (--with-stream)"
    exit 1
fi

ngx_module_srcs="$ngx_addon_dir/$ngx_addon_name.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=STREAM
    ngx_module_name=$ngx_addon_name

    . auto/module
else
    STREAM_MODULES="$STREAM_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_module_srcs"
fi
